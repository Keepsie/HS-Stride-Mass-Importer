<Window x:Class="HS.Stride.Mass.Importer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HS Stride Mass Importer" 
        Height="700" Width="650" ResizeMode="CanMinimize">
    
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Main Content -->
        <ScrollViewer Grid.Row="0" Background="White" Margin="0,0,0,1">
            <StackPanel Margin="40">
                
                <!-- Header with Icon -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <Image Source="hs_mass_importer.png" Width="40" Height="40" Margin="0,0,10,0" 
                           VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Stride Mass Importer" FontSize="20" FontWeight="Bold" Foreground="#333"/>
                        <TextBlock Text="Mass Import raw assets into your Stride project" FontSize="12" Foreground="#666"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Package Name Section -->
                <StackPanel Margin="0,0,0,30">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="📥" FontSize="16" Margin="0,0,8,0" 
                                 Foreground="#FF1B7ECC"/>
                        <TextBlock Text="Package Name" FontSize="14" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox Name="PackageNameBox" Height="35" FontSize="13" 
                             BorderBrush="#DDD" BorderThickness="1" Padding="8"/>
                    <TextBlock Text="Enter a name for your asset package (e.g., 'Characters', 'Environment')" 
                               FontSize="11" Foreground="#666" Margin="0,4,0,0"/>
                </StackPanel>
                
                <!-- Source Folder Section -->
                <StackPanel Margin="0,0,0,30">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="📂" FontSize="16" Margin="0,0,8,0" 
                                 Foreground="#FFDA8E1F"/>
                        <TextBlock Text="Source Assets Folder" FontSize="14" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Name="SourceFolderBox" Grid.Column="0" Height="35" FontSize="13" 
                                 BorderBrush="#DDD" BorderThickness="1" Padding="8" Margin="0,0,8,0"/>
                        <Button Name="BrowseSourceButton" Grid.Column="1" Content="📁 Browse" 
                                Width="90" Height="35" Background="#E3F2FD" BorderBrush="#2196F3" 
                                BorderThickness="1" Foreground="#1976D2" FontWeight="SemiBold"
                                Click="BrowseSourceButton_Click"/>
                    </Grid>
                    <TextBlock Text="Select the folder containing your .fbx, .png, .json files, etc." 
                               FontSize="11" Foreground="#666" Margin="0,4,0,0"/>
                </StackPanel>
                
                <!-- Target Project Section -->
                <StackPanel Margin="0,0,0,30">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🎯" FontSize="16" Margin="0,0,8,0" 
                            Foreground="#28A745"/>
                        <TextBlock Text="Target Project" FontSize="14" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Name="StrideProjectBox" Grid.Column="0" Height="35" FontSize="13" 
                                 BorderBrush="#DDD" BorderThickness="1" Padding="8" Margin="0,0,8,0"/>
                        <Button Name="BrowseProjectButton" Grid.Column="1" Content="📁 Browse" 
                                Width="90" Height="35" Background="#E3F2FD" BorderBrush="#2196F3" 
                                BorderThickness="1" Foreground="#1976D2" FontWeight="SemiBold"
                                Click="BrowseProjectButton_Click"/>
                    </Grid>
                    <TextBlock Text="Select target Stride project directory" 
                               FontSize="11" Foreground="#666" Margin="0,4,0,0"/>
                </StackPanel>
                
                <!-- Options -->
                <StackPanel Margin="0,0,0,30">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="⚙" FontSize="16" Margin="0,0,8,0" Foreground="#666"/>
                        <TextBlock Text="Options" FontSize="14" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center"/>
                    </StackPanel>
                    <CheckBox Name="CreateMaterialsCheckBox" Content="Create materials for textures"
                              IsChecked="True" FontSize="13" Foreground="#333"/>
                </StackPanel>

                <!-- Warning -->
                <Border Background="#FFF3CD" BorderBrush="#FFEAA7" BorderThickness="1"
                        CornerRadius="4" Padding="12" Margin="0,0,0,30">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" FontSize="16" Foreground="#856404" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Important: Close Stride GameStudio before importing packages"
                                   FontSize="12" Foreground="#856404" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- Import Button -->
                <Button Name="ImportButton" Height="45" FontSize="14" FontWeight="SemiBold"
                        Background="#FF3A923D" Foreground="White" BorderThickness="0"
                        Click="ImportButton_Click" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📦" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Import Package" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <!-- Progress -->
                <ProgressBar Name="ProgressBar" Height="6" Visibility="Collapsed" 
                             Margin="0,15,0,0" Background="#E0E0E0" Foreground="#4CAF50"/>
                <TextBlock Name="StatusText" Text="" HorizontalAlignment="Center" 
                           FontSize="12" Foreground="#666" Margin="0,10,0,0"/>
                
            </StackPanel>
        </ScrollViewer>
        
        <!-- Footer -->
        <Border Grid.Row="1" Background="#E3F2FD" Height="30" BorderBrush="#2196F3" BorderThickness="0,1,0,0">
            <TextBlock Text="Copyright © 2025 Happenstance Games" HorizontalAlignment="Center" 
                       VerticalAlignment="Center" FontSize="11" Foreground="#1976D2"/>
        </Border>
    </Grid>
</Window>
